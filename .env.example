# Required — OpenRouter API key for screenshot vision analysis
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — which vision-capable model to use via OpenRouter
# Defaults to google/gemini-flash-1.5 if not set
# Other good options:
#   anthropic/claude-sonnet-4-5
#   openai/gpt-4o
#   meta-llama/llama-3.2-90b-vision-instruct
OPENROUTER_MODEL=google/gemini-flash-1.5

# Optional — enables real Google Places ratings, addresses, and map links
# Without this key the tool still works; it generates a Google Maps search URL instead
GOOGLE_PLACES_API_KEY=AIza...

# Optional — path to the SQLite database file (default: food_locations.db in CWD)
FOOD_DB_PATH=food_locations.db
